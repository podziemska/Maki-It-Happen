        <Label Content="0" HorizontalAlignment="Left" Margin="198,301,0,0" VerticalAlignment="Top" Height="62" Width="56" FontSize="36" FontWeight="Bold"/>
        <Label Content="0" HorizontalAlignment="Left" Margin="602,181,0,0" VerticalAlignment="Top" Height="62" Width="56" FontSize="36" FontWeight="Bold"/>
