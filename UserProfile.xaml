        <Button Content="" Margin="473,173,70,0" VerticalAlignment="Top" Height="79" RenderTransformOrigin="0.416,0.342" Background="#FFFFFDD8"/>
        <Button Content="" HorizontalAlignment="Left" Margin="473,290,0,0" VerticalAlignment="Top" Height="79" Width="257" RenderTransformOrigin="0.416,0.342" Background="#FFFFFDD8"/>
        <Image HorizontalAlignment="Left" Height="168" Margin="62,243,0,0" VerticalAlignment="Top" Width="219" Source="/fotomaki.png" RenderTransformOrigin="0.619,0.726"/>
        <Image Height="165" Margin="447,257,136,0" VerticalAlignment="Top" Source="/hosomaki.png" RenderTransformOrigin="0.619,0.726"/>
        <Image HorizontalAlignment="Left" Height="168" Margin="68,128,0,0" VerticalAlignment="Top" Width="223" Source="/onigiri.png" RenderTransformOrigin="0.619,0.726"/>
        <Image HorizontalAlignment="Left" Height="100" Margin="515,128,0,0" VerticalAlignment="Top" Width="100"/>
        <Image Height="184" Margin="436,120,126,0" VerticalAlignment="Top" Source="/nigiri.png" RenderTransformOrigin="0.619,0.726"/>
