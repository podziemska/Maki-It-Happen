<Window x:Class="Maki_it_happen.SalaGlowna"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Maki_it_happen"
        mc:Ignorable="d"
        Title="Sala Główna" Height="750" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="10" 
                                BorderBrush="White" 
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#FF666666"/>
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Storyboard x:Key="KlientOdchodziAnimacja">
            <DoubleAnimation Storyboard.TargetName="KlientTransform"
                             Storyboard.TargetProperty="X"
                             To="-800" 
                             Duration="0:0:2">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="KlientImage"
                             Storyboard.TargetProperty="Opacity"
                             To="0" 
                             BeginTime="0:0:1.5" 
                             Duration="0:0:0.5"/>
        </Storyboard>
    </Window.Resources>

    

    <Grid>
       
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" 
                Margin="0,20,30,0"
                Background="#AA000000" 
                CornerRadius="15" 
                Padding="20,10">
            <TextBlock x:Name="KasaLabel" 
                       Text="KASA: 0$" 
                       Foreground="#62B5B5" 
                       FontSize="32" 
                       FontWeight="Bold"/>
        </Border>

        <Canvas Grid.Row="1">
            <Image x:Name="KlientImage" 
                   Source="/images/klient.png" 
                   Width="180" 
                   Height="350"
                   Canvas.Right="50" 
                   Canvas.Bottom="0"
                   Opacity="0">
                <Image.RenderTransform>
                    <TranslateTransform x:Name="KlientTransform" X="0" Y="0"/>
                </Image.RenderTransform>
            </Image>
        </Canvas>
        
        <Image Source="/sala_glowna.png"
        Stretch="Fill"
        Panel.ZIndex="0" Grid.RowSpan="3"/>
 
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">

            <Button x:Name="NowyKlientBtn"
                    Content="NOWY KLIENT"
                    Background="#FFA027CA"
                    Style="{StaticResource MenuButtonStyle}"
                    Click="NowyKlient_Click"/>

            <Button x:Name="OdbierzBtn"
                    Content="ODBIERZ ZAMÓWIENIE"
                    Background="#FF27A9CA"
                    IsEnabled="False"
                    Style="{StaticResource MenuButtonStyle}"
                    Click="OdbierzZamowienie_Click"/>

            <Button x:Name="KuchniaBtn"
                    Content="IDŹ DO KUCHNI"
                    Background="#FF9CCA27"
                    Style="{StaticResource MenuButtonStyle}"
                    Click="Kuchnia_Click"/>
            
        </StackPanel>
        <Image x:Name="SushiImage"

        Width="1000"
        Height="750"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Grid.RowSpan="3"
        Panel.ZIndex="999"
        IsHitTestVisible="False"/>

        </Grid>
</Window>
