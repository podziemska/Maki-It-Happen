<Window x:Class="Maki_it_happen.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kuchnia - Maki it happen" Height="750" Width="1000">

    <Window.Resources>
        <Style x:Key="SushiButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="12" 
                                BorderBrush="White" 
                                BorderThickness="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Background>
        <ImageBrush ImageSource="/images/GameWindow.jpg"/>
    </Window.Background>

    <Grid x:Name="MainGrid" Margin="0,3,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition/>
            <RowDefinition Height="126.04"/>
            <RowDefinition Height="130"/>
        </Grid.RowDefinitions>


        
        <Button Content="SALA GŁÓWNA" Background="#9B59B6" Foreground="White" Padding="10,5" Click="OpenSala_Click" Height="48" Width="129" Margin="436,10,436,42" />

        <Button Content="SKLEP 🛒" Background="#9B59B6" Foreground="White" Padding="10,5" Click="OpenShop_Click" Height="48" Width="129" Margin="10,10,861,42"/>






        <TextBlock x:Name="KasaLabel" Text="KASA: 100$" Foreground="#F1C40F" FontSize="36" FontWeight="Bold" Margin="761,10,-2,0"/>
        






        <Grid x:Name="SushiLayers" Grid.Row="2">
            <Label x:Name="usun"
           Content="Label"
           HorizontalAlignment="Left"
           VerticalAlignment="Center"
           Width="277"/>
        </Grid>


        <Border Grid.Row="3">

            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="529*"/>
                    <ColumnDefinition Width="431*"/>
                </Grid.ColumnDefinitions>

                <!-- PANEL WYBORU TYPU SUSHI -->
                <UniformGrid x:Name="SushiTypePanel" Columns="4" Grid.ColumnSpan="2">
                    <Button Style="{StaticResource SushiButtonStyle}" Click="Onigiri_Click">
                        <StackPanel>
                            <TextBlock Text="🍙" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock Text="ONIGIRI" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SushiButtonStyle}" Click="Nigiri_Click">
                        <StackPanel>
                            <TextBlock Text="🍣" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock Text="NIGIRI" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SushiButtonStyle}" Click="Hosomaki_Click" Cursor="Hand">
                        <StackPanel>
                            <TextBlock Text="🥢" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock Text="HOSOMAKI" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SushiButtonStyle}" Click="Futomaki_Click">
                        <StackPanel>
                            <TextBlock Text="🍱" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock Text="FUTOMAKI" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <!-- PANEL SKŁADNIKÓW (ukryty) -->
                <UniformGrid x:Name="IngredientsPanel" Columns="5" Visibility="Collapsed" Grid.ColumnSpan="2" Cursor="">

                    <Button x:Name="RiceButton" Style="{StaticResource SushiButtonStyle}" Click="AddRice_Click ">
                        <StackPanel>
                            <TextBlock Text="🍚" FontSize="30" HorizontalAlignment="Center"/>
                            <TextBlock Text="RYŻ" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="RiceCountLabel" Text="Szt: 10" FontSize="10" Foreground="#F1C40F" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="FishButton" Style="{StaticResource SushiButtonStyle}" Click="AddFish_Click">
                        <StackPanel>
                            <TextBlock Text="🐟" FontSize="30" HorizontalAlignment="Center"/>
                            <TextBlock Text="ŁOSOŚ" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="FishCountLabel" Text="Szt: 5" FontSize="10" Foreground="#F1C40F" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="CucumberButton" Style="{StaticResource SushiButtonStyle}" Click="AddCucumber_Click">
                        <StackPanel>
                            <TextBlock Text="🥒" FontSize="30" HorizontalAlignment="Center"/>
                            <TextBlock Text="OGÓREK" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="CucumberCountLabel" Text="Szt: 8" FontSize="10" Foreground="#F1C40F" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NoriButton" Style="{StaticResource SushiButtonStyle}" Click="AddNori_Click">
                        <StackPanel>
                            <TextBlock Text="⬛" FontSize="30" HorizontalAlignment="Center"/>
                            <TextBlock Text="NORI" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="NoriCountLabel" Text="Szt: 12" FontSize="10" Foreground="#F1C40F" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Background="#2ECC71" Click="Serve_Click">
                        <StackPanel>
                            <TextBlock Text="✅" FontSize="30" HorizontalAlignment="Center"/>
                            <TextBlock Text="SERWUJ!" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                    <Button Background="Red" Click="Cancel_Click">
                        <StackPanel>
                            <TextBlock Text="×" FontSize="30" HorizontalAlignment="Center"/>
                            <TextBlock Text="Anuluj" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                </UniformGrid>

            </Grid>
        </Border>

    </Grid>
</Window>
