<Window x:Class="Maki_it_happen.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kuchnia - Maki it happen" Height="750" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="SushiButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E74C3C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="12" 
                                BorderBrush="White" 
                                BorderThickness="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Background>
        <ImageBrush ImageSource="/images/GameWindow.jpg"/>
    </Window.Background>

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="130"/>
            <RowDefinition Height="130"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="10">
            <Button Content="SKLEP 🛒" Background="#9B59B6" Foreground="White" Width="120" Height="45" Click="OpenShop_Click" DockPanel.Dock="Left"/>
            <Button Content="SALA GŁÓWNA" Background="#9B59B6" Foreground="White" Width="130" Height="45" Click="OpenSala_Click" HorizontalAlignment="Center"/>
            <TextBlock x:Name="KasaLabel" Text="KASA: 100$" Foreground="#F1C40F" FontSize="36" FontWeight="Bold" DockPanel.Dock="Right" VerticalAlignment="Center" TextAlignment="Right"/>
        </DockPanel>

        <Grid x:Name="SushiLayers" Grid.Row="1" Grid.RowSpan="2">
        </Grid>

        <Label x:Name="usun" Content="Gotowy?" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Row="1" Foreground="White" Background="#80000000" Margin="10"/>

        <Border Grid.Row="3" Background="#AA000000" CornerRadius="15,15,0,0">
            <Grid Margin="10">
                <UniformGrid x:Name="SushiTypePanel" Columns="4" Visibility="Visible">
                    <Button Style="{StaticResource SushiButtonStyle}" Click="Onigiri_Click">
                        <StackPanel>
                            <TextBlock Text="🍙" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock Text="ONIGIRI" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SushiButtonStyle}" Click="Nigiri_Click">
                        <StackPanel>
                            <TextBlock Text="🍣" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock Text="NIGIRI" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SushiButtonStyle}" Click="Hosomaki_Click">
                        <StackPanel>
                            <TextBlock Text="🥢" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock Text="HOSOMAKI" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SushiButtonStyle}" Click="Futomaki_Click">
                        <StackPanel>
                            <TextBlock Text="🍱" FontSize="40" HorizontalAlignment="Center"/>
                            <TextBlock Text="FUTOMAKI" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <UniformGrid x:Name="IngredientsPanel" Columns="6" Visibility="Collapsed">
                    <Button x:Name="RiceButton" Style="{StaticResource SushiButtonStyle}" Click="AddRice_Click">
                        <StackPanel>
                            <TextBlock Text="🍚" FontSize="25" HorizontalAlignment="Center"/>
                            <TextBlock Text="RYŻ" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="RiceCountLabel" Text="Szt: 10" FontSize="10" Foreground="#F1C40F" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="FishButton" Style="{StaticResource SushiButtonStyle}" Click="AddFish_Click">
                        <StackPanel>
                            <TextBlock Text="🐟" FontSize="25" HorizontalAlignment="Center"/>
                            <TextBlock Text="ŁOSOŚ" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="FishCountLabel" Text="Szt: 5" FontSize="10" Foreground="#F1C40F" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="CucumberButton" Style="{StaticResource SushiButtonStyle}" Click="AddCucumber_Click">
                        <StackPanel>
                            <TextBlock Text="🥒" FontSize="25" HorizontalAlignment="Center"/>
                            <TextBlock Text="OGÓREK" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="CucumberCountLabel" Text="Szt: 8" FontSize="10" Foreground="#F1C40F" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NoriButton" Style="{StaticResource SushiButtonStyle}" Click="AddNori_Click">
                        <StackPanel>
                            <TextBlock Text="⬛" FontSize="25" HorizontalAlignment="Center"/>
                            <TextBlock Text="NORI" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="NoriCountLabel" Text="Szt: 12" FontSize="10" Foreground="#F1C40F" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Background="#E67E22" Click="Cancel_Click" Margin="5">
                        <StackPanel>
                            <TextBlock Text="❌" FontSize="25" HorizontalAlignment="Center"/>
                            <TextBlock Text="ANULUJ" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Button>

                    <Button Background="#2ECC71" Click="Serve_Click" Margin="5">
                        <StackPanel>
                            <TextBlock Text="✅" FontSize="25" HorizontalAlignment="Center"/>
                            <TextBlock Text="SERWUJ!" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Grid>
        </Border>
        <TextBlock x:Name="czas" HorizontalAlignment="Left" Margin="271,31,0,0" TextWrapping="Wrap" Text="⏱ 0s" VerticalAlignment="Top" Height="48" Width="182" FontSize="24" FontWeight="Bold" Foreground="White"/>
    </Grid>
</Window>
